{
  "name": "fa-ontology-mapping",
  "private": true,
  "version": "0.2.0",
  "description": "An interactive map of definitions related to the federation of data within UK health data research systems. Led by Lancashire Teaching Hospitals NHS Foundation Trust.",
  "license": "Apache-2.0",
  "author": "Lancashire Teaching Hospitals NHS Foundation Trust and contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/lsc-sde/FA-ontology-mapping.git"
  },
  "keywords": [
    "ontology",
    "federation",
    "federated-research",
    "health-data",
    "trusted-research-environment",
    "secure-data-environment",
    "dare-uk",
    "datashield",
    "satre",
    "five-safes",
    "fair-data",
    "pedri",
    "public-involvement"
